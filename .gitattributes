# Normalise text files to LF inside the repository.
* text=auto eol=lf

# Windows-specific scripts keep CRLF in the working tree.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat these as binary: never diff, never convert line endings.
*.stl   binary
*.3mf   binary
*.step  binary
*.stp   binary
*.f3d   binary
*.FCStd binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ino   text
